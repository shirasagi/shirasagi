# docker_line 用の環境変数。コピーして .env にする: cp docker_line/.env.example docker_line/.env
# （.env は git 管理外。トークンをコミットしないこと）

# ---- 必須ではない（ローカルで管理画面を触るだけなら未設定でよい） ----

# LINE からの Webhook / LINE Login のコールバックを受けるための公開 URL（ngrok）。
# https://dashboard.ngrok.com/ で発行する。無料プランでも固定ドメインを 1 つ使える。
# NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NGROK_DOMAIN=your-name.ngrok-free.app

# 配信予約を自動実行する間隔（秒）。既定 900 = 15 分（本番 cron と同じ）
# LINE_DELIVER_INTERVAL=900
