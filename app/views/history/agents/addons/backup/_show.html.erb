<%
  addon ||= local_assigns.fetch(:addon, {})
  addon[:display_body] = "hide"

  setting = History::BackupFrameSetting.new(
    ref_path: SS.request_path(request), ref_class: @item.class.name, ref_id: @item.id)
%>

<turbo-frame src="<%= history_cms_frames_backups_path(setting: setting.to_signed_jwt) %>" id="<%= addon[:id] %>-frame" loading="lazy">
  <%= loading %>
</turbo-frame>
