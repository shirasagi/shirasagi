<%= form_for :item, url: { action: :update }, html: { method: :put } do |f| %>
<%= error_messages_for :item %>

<section class="main-box">
  <header><h2><%= t("history.confirm.restore") %></h2></header>
  <dl class="see">
    <dt class="wide"><%= t :"history.current_data" %></dt>

    <% if ref_item.present? %>
      <dt><%= @model.t :updated %></dt>
      <dd><%= I18n.l(ref_item.updated) rescue nil %></dd>
    <% end %>

    <dt><%= @model.t :version %></dt>
    <dd><%= SS.version %></dd>

    <dt class="wide"><%= t :"history.backup_data" %></dt>

    <dt><%= @model.t :updated %></dt>
    <dd><%= I18n.l(@item.data['updated'].in_time_zone) rescue nil %></dd>

    <dt><%= @model.t :version %></dt>
    <dd><%= @item.version %></dd>
  </dl>
</section>

<% if SS.version != @item.version || Rails.env.development? %>
<div style="margin: 20px 0 0; text-align: center;">
  <%= t "history.notice.restore" %>
</div>
<% end %>

<footer class="send">
  <%= f.submit t("history.buttons.restore"), class: 'btn-primary save' %>
  <%= f.button t("ss.buttons.cancel"), type: :reset, class: 'btn-default', onclick: "location.href='#{url_for(action: :show)}'; return false;" %>
</footer>

<% end %>
