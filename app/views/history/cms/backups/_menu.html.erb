<nav class="nav-menu">
  <%
    source = CGI.unescape(params[:source])
    link_to_source = nil
    if UrlValidator.valid?(source, absolute_path: true) && Sys::TrustedUrlValidator.myself_url?(source)
      link_to_source = link_to(t('ss.links.back'), source)
    end
  %>
  <% if params[:action] =~ /change/ %>
    <%= link_to_source %>
  <% elsif params[:action] =~ /restore/ %>
    <%= link_to t('ss.links.back'), action: :show %>
  <% else %>
    <%= link_to_source %>
    <%= link_to t("history.restore"), action: :restore if @item.restorable? %>
  <% end %>
</nav>
