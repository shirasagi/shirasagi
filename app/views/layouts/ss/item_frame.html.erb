<%
  frame_id = @frame_id.presence || try(:turbo_frame).presence || "item-frame"
  body = capture { yield }
%>
<turbo-frame id="<%= frame_id %>">
  <%= body %>

  <%= javascript_tag do %>
    document.documentElement.addEventListener("turbo:frame-load", function() {
      SS.render("#<%= frame_id %>");
      SS_SearchUI.render();
    }, { once: true });

    <% if notice.present? %>
      SS.ready(function() {
        SS.notice(<%== notice.to_json %>);
      });
    <% end %>
  <% end %>
</turbo-frame>
