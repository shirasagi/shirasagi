<div class="addon-views">
  <div class="addon-view" id="addon-basic">
    <div class="addon-head"><h2><%= t("sns.file_gen_task.completed") %></h2></div>
    <div class="addon-body">
      <p>The download is ready.</p>
      <p>If the download does not start automatically, please click the download button below to download the file, and then close the dialog box once the download is complete.</p>
      <p class="mt-2">
        <%= link_to t("ss.buttons.download"), sns_apis_file_gen_task_download_path(id: @item), class: "btn", data: { turbo: false, "ss--file-gen-task-target" => "instantlyClickAndClose" } %>
      </p>
    </div>
  </div>
</div>
