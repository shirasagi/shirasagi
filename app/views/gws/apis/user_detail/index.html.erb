<%= jquery do %>
$(".user-detail-modal .clipboard-copy-button.dummy").remove();
SS_Clipboard.renderCopy();
<% end %>

<div class="user-detail-modal">
  <dl class="see">
    <dt><%= @item.t :name %></dt>
    <dd><%= @item.name %></dd>

    <% if @item.kana.present? %>
      <dt><%= @item.t :kana %></dt>
      <dd><%= @item.kana %></dd>
    <% end %>

    <% if @item.email.present? %>
      <dt><%= @item.t :email %></dt>
      <dd>
        <span class="email js-clipboard-copy"><%= mail_to @item.email %></span>
        <a href="#" class="clipboard-copy-button dummy"><%= t("ss.buttons.copy") %></a>
      </dd>
    <% end %>

    <% if @item.tel.present? %>
      <dt><%= @item.t :tel %></dt>
      <dd><%= @item.tel %></dd>
    <% end %>

    <% if @item.tel_ext.present? %>
      <dt><%= @item.t :tel_ext %></dt>
      <dd><%= @item.tel_ext %></dd>
    <% end %>

    <% title = @item.title(@cur_site) %>
    <% if title %>
      <dt><%= @item.t :title_ids %></dt>
      <dd><%= title.name_with_code %></dd>
    <% end %>

    <% occupation = @item.occupation(@cur_site) %>
    <% if occupation %>
      <dt><%= @item.t :in_occupation_id %></dt>
      <dd><%= occupation.name_with_code %></dd>
    <% end %>

    <% main_group = @item.gws_main_group(@cur_site) %>
    <dt><%= @item.t :group_ids %></dt>
    <dd>
      <% @item.groups.order_by(name: 1).select{ |c| Gws::Group.site(@cur_site).pluck(:id).include?(c.id) }.each do |c| %>
        <% if main_group && main_group.id == c.id %>
          <strong><b><%= c.trailing_name %></b></strong><br />
        <% else %>
          <%= c.trailing_name %><br />
        <% end %>
      <% end %>
    </dd>

  <% user_presence = @item.user_presence(@cur_site) %>
  <dt><%= user_presence.t :presence_status %></dt>
  <dd>
    <span class="presence-state <%= user_presence.state_style %>">
      <%= user_presence.label :state %>
    </span>
  </dd>

  <% if user_presence.plan.present? %>
    <dt><%= user_presence.t :plan %></dt>
    <dd><%= user_presence.plan %></dd>
  <% end %>

  <% if user_presence.memo.present? %>
    <dt><%= user_presence.t :memo %></dt>
    <dd><%= user_presence.memo %></dd>
  <% end %>

  <% if user_presence.manager_name.present? %>
    <dt><%= user_presence.t :manager_name %></dt>
    <dd><%= user_presence.manager_name %></dd>
  <% end %>

  <% if user_presence.department.present? %>
    <dt><%= user_presence.t :department %></dt>
    <dd><%= user_presence.department %></dd>
  <% end %>
</dl>

  <footer class="send">
    <%= button_tag t("ss.buttons.close"), class: 'btn-default', type: :reset, onclick: "$.colorbox.close(); return false;" %>
  </footer>
</div>
