<%
  addons = @addons || @item.try(:addons) || []

  html_option = { id: "item-form", method: :put, multipart: true, autocomplete: :off }

  if @auto_save_enabled && (url_for(action: :resume_edit) rescue nil)
    # 自動保存が有効 & resume アクションが定義位されている場合
    html_option[:data] = { controller: "ss--auto-save", "ss--auto-save-user-id-value" => @cur_user.id, "ss--auto-save-resume-url-value" => url_for(action: :resume_edit) }
  end
%>

<%= jquery do %>
new ScrollHint('.js-scrollable', {
  i18n: {
    scrollable: '<%= t('gws/presence.scrollable') %>'
  }
});
<% end %>

<%= form_for :item, url: { action: :user_edit }, html: html_option do |f| %>
<%= error_messages_for :item %>

<%= hidden_field_tag :_updated, params[:_updated] || @item.updated if @item.respond_to?(:updated) %>
<%= hidden_field_tag :page, params[:page] %>

<div class="main-box presence-users presence-user-search">
  <p class="lead-scroll"><%= t('gws/presence.lead_scroll') %></p>
  <div class="data-table-wrap wrap-table js-scrollable">
    <table class="index data-table">
      <thead>
      <tr>
        <th><%= Gws::UserPresence.t :presence_status %></th>
        <th><%= Gws::UserPresence.t :memo %></th>
        <th><%= Gws::UserPresence.t :affiliation %></th>
        <th><%= Gws::UserPresence.t :manager_name %></th>
        <th><%= br Gws::UserPresence.t(:title_id).sub('（', "\n（") %></th>
        <th><%= Gws::UserPresence.t :staff_name %></th>
        <th><%= br Gws::UserPresence.t(:staff_kana).sub('（', "\n（") %></th>
        <th><%= @model.t :tel_ext %></th>
        <th><%= br Gws::UserPresence.t(:department).sub('（', "\n（") %></th>
      </tr>
      </thead>
      <tbody>
      <% @items.each do |item| %>
        <% user_presence = item.user_presence(@cur_site) %>
        <tr class="editable" data-id="<%= item.id %>">
          <td class="no-overflow">
            <span class="presence-state <%= user_presence.state_style %>">
              <%= user_presence.label :state %>
            </span>
          </td>
          <td class="no-overflow">
            <%= text_field_tag "#{f.object_name}[#{item.id}][memo]", user_presence.memo, id: nil %>
          </td>
          <td class="no-overflow">
            <%= item.gws_main_group(@cur_site).trailing_name %>
          </td>
          <td class="no-overflow">
            <%= text_field_tag "#{f.object_name}[#{item.id}][manager_name]", user_presence.manager_name, id: nil %>
          </td>
          <td class="no-overflow">
            <%= tryb { item.title(@cur_site).name } %>
          </td>
          <td class="no-overflow">
            <%= item.send :name %>
          </td>
          <td class="no-overflow">
            <%= item.send :kana %>
          </td>
          <td class="no-overflow">
            <%= text_field_tag "#{f.object_name}[#{item.id}][tel_ext]", item.tel_ext, id: nil %>
          </td>
          <td class="no-overflow">
            <%= text_field_tag "#{f.object_name}[#{item.id}][department]", user_presence.department, id: nil %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>

<footer class="send ss-sticky ss-sticky-bottom">
  <% if @crud_buttons %>
    <% @crud_buttons.call f %>
  <% else %>
    <%= f.submit t("ss.buttons.save"), class: 'btn-primary save', data: { disable_with: t("ss.buttons.saving") } %>
    <%= f.button t("ss.buttons.cancel"), class: 'btn-default', type: :reset, onclick: "location.href='#{url_for(action: :index)}'; return false;" %>
  <% end %>
</footer>

<% end %>

<%= jquery do %> SS.confirmUnloading(); <% end %>
