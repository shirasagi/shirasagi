<% return "" if @item.files.blank? %>

<div class="see gws-addon-file">
  <div id="selected-files">
    <% @item.files.each do |file| %>
      <div id="file-<%= file.id %>" class="file-view" data-file-id="<%= file.id %>">
        <%= sanitizer_status(file) %>
        <%= link_to file.url, class: "thumb #{SS::DownloadPolicy.html_class}", target: "_blank", rel: "noopener" do %>
          <% if file.image? %>
            <%= image_tag file.thumb_url, alt: file.name %>
          <% else %>
            <span class="ext icon-<%= file.extname %>"><%= file.extname %></span>
          <% end %>
        <% end %>

        <div class="name">
          <label>
            <%= file.name %>
          </label><br />
        </div>
      </div>
    <% end %>
  </div>
  <div class="menu">
    <% if SS::DownloadPolicy.download_allowed? %>
      <%= ss_button_to(t("gws/notice.links.download_attachment"), url_for(action: :download_attachment), confirm: t("ss.confirm.download"), class: 'btn btn-download') rescue nil %>
    <% end %>
  </div>
</div>
