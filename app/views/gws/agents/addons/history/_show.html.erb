<%
  return unless @item.class.show_history
  addon ||= local_assigns.fetch(:addon, {})
  addon[:display_body] = "hide"
%>

<turbo-frame src="<%= gws_frames_addons_histories_path(model_class: @item.class.to_s, model_id: @item.id) %>"
  id="gws-addon-history-frame" loading="lazy">
  <%= loading %>
</turbo-frame>
