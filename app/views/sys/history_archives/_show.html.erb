<dl class="see">
  <dt><%= @model.t :name %></dt>
  <dd><%= @item.name %></dd>

  <dt><%= @model.t :filename %></dt>
  <dd>
    <%= @item.filename %>
    <% if SS::DownloadPolicy.download_allowed? %>
      <%= link_to(t('ss.links.download'), @item.url, class: :btn) %>
    <% end %>
  </dd>

  <dt><%= @model.t :size %></dt>
  <dd><%= number_to_human_size(@item.size) %></dd>
</dl>
