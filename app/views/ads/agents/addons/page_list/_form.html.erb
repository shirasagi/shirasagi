<% addon ||= local_assigns.fetch(:addon, {}) %>

<div data-controller="ss--data-setter" data-ss--data-setter-attribute-name-value="loopFormat" data-loop-format="<%= @item.loop_format.presence || "shirasagi" %>">
  <dl class="see">
    <dt><%= @model.t :sort %><%= @model.tt :sort %></dt>
    <dd><%= f.select :sort, @item.sort_options, include_blank: " " %></dd>

    <dt><%= @model.t :with_category %><%= @model.tt :with_category %></dt>
    <dd><%= f.select :with_category, @item.with_category_options, include_blank: " " %></dd>

    <dt class="loop_format"><%= @model.t :loop_format %><%= @model.tt :loop_format %></dt>
    <dd class="loop_format"><%= f.select :loop_format, @item.loop_format_options, {}, { data: { action: "change->ss--data-setter#set" } } %></dd>
  </dl>

  <dl class="see loop-format-shirasagi">
    <dt><%= @model.t :upper_html %><%= @model.tt :upper_html %></dt>
    <dd><%= f.text_area :upper_html, class: "html" %></dd>

    <dt><%= @model.t :link_action %><%= @model.tt :link_action %></dt>
    <dd><%= f.select :link_action, @item.link_action_options %></dd>

    <dt><%= @model.t :link_target %><%= @model.tt :link_target %></dt>
    <dd><%= f.select :link_target, @item.link_target_options, include_blank: t("ads.options.link_target.individual_setting") %></dd>

    <dt><%= t("cms.loop_html") %><%= @model.tt :loop_html %></dt>
    <dd><%= f.text_area :loop_html, class: "html", style: "height: 100px;" %></dd>

    <dt><%= @model.t :lower_html %><%= @model.tt :lower_html %></dt>
    <dd><%= f.text_area :lower_html, class: "html" %></dd>
  </dl>

  <dl class="see loop-format-liquid">
    <dt><%= @model.t :loop_liquid %><%= @model.tt :loop_liquid %></dt>
    <dd><%= f.text_area :loop_liquid, class: "html", style: "height: 300px;" %></dd>
  </dl>
</div>

<%= code_editor "##{addon[:id]} .html", mode: :html %>
