<%
  return if @items.blank?
  wrap_id = "ss-image-box-#{@items[0].id}"
%>
<%= jquery do %>
  Ads_Banner.randomize("#<%= wrap_id %> .ss-image-box-item-list");
<% end if @random %>
<div class="ss-image-box" id="<%= wrap_id %>">
  <%== @cur_part.upper_html if @cur_part.loop_format_shirasagi? && @cur_part.upper_html.present? %>

  <%=
    case @cur_part.loop_format
    when "liquid"
      if @cur_part.loop_liquid.present?
        render "liquid_loop"
      end
    else # "shirasagi"
      if @cur_part.loop_html.present?
        render "shirasagi_loop"
      else
        render "default_loop"
      end
    end
  %>

  <%== @cur_part.lower_html if @cur_part.loop_format_shirasagi? && @cur_part.lower_html.present? %>
</div>
