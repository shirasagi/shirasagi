<dl class="see">
  <dt><%= @model.t :name %></dt>
  <dd><%= @item.send :name %></dd>

  <dt><%= @model.t :link_url %></dt>
  <dd><%= link_to @item.link_url, sns_redirect_path(ref: @item.link_url), target: "_blank", rel: "noopener" %></dd>

  <dt><%= @model.t :file_id %></dt>
  <dd><%= show_image_info @item.file %></dd>

  <dt><%= @model.t :link_target %></dt>
  <dd><%= @item.label(:link_target) %></dd>

  <dt><%= @model.t :order %></dt>
  <dd><%= @item.send :order %></dd>
</dl>
