<dl class="{{ dl_class }}">
  <dt>
    <time datetime="{{ date | ss_date: "iso" }}">
      {% if active? and events.size > 0 %}
        <a href="{{ daily_url }}">{{ date_label }}</a>
      {% else %}
        {{ date_label }}
      {% endif %}
      <span class="wday">
        (<abbr title="{{ wday_label }}曜日">{{ wday_label }}</abbr><span class="unit">曜日</span>)
      </span>
    </time>
  </dt>

  {% if holiday? %}
    <dd class="holiday">{{ holiday_name }}</dd>
  {% endif %}

  {% if events.size == 0 %}
    <dd class="no-event">{{ substitute_html }}</dd>
  {% endif %}

  {% for event in events %}
    {% if event.url contains "courses" %}
      {% assign event_type = "course" %}
    {% else %}
      {% assign event_type = "event" %}
    {% endif %}

    <dd class="page page--{{ event_type }} {{ event.multiple_or_single_days }}"
        data-id="{{ event.data_id }}"
        data-start-date="{{ event.data_start_date }}"
        data-end-date="{{ event.data_end_date }}">

      <article class="event-list__article{% if event.page.new? %} new{% endif %}">
        {% if event.category %}
          <div class="event-list__category">
            <a href="{{ event.category.url }}">
              <span class="event-cat data {{ event.category.basename }}">
                <span class="event-cat__icon" aria-hidden="true"></span>
                <span class="event-cat__text">{{ event.category.name }}</span>
              </span>
            </a>
          </div>
        {% endif %}

        <header>
          <h2>
            <a href="{{ event.url }}">
              {% assign has_datetime = false %}

              {% for specific in event.specifics %}
                {% if specific.datetime? %}
                  {% assign has_datetime = true %}
                  <span class="event-list__time {{ specific.kind }}">
                    <time datetime="{{ specific.start_at | ss_time: "iso" }}" class="start">
                      {{ specific.start_at | ss_time: "h_mm" }}
                    </time>
                    <span class="unit">-</span>
                    <time datetime="{{ specific.end_at | ss_time: "iso" }}" class="end">
                      {{ specific.end_at | ss_time: "h_mm" }}
                    </time>
                  </span>
                {% endif %}
              {% endfor %}

              {% unless has_datetime %}
                <span class="event-list__time event-list__time--allday">終日</span>
              {% endunless %}

              <span class="name">{{ event.name }}</span>
            </a>
          </h2>
        </header>
      </article>
    </dd>
  {% endfor %}
</dl>
