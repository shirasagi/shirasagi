{% for event in events %}
  {% if event.url contains "courses" %}
    {% assign event_type = "course" %}
  {% else %}
    {% assign event_type = "event" %}
  {% endif %}

  <div class="page page--{{ event_type }} {{ event.multiple_or_single_days }}"
      data-id="{{ event.data_id }}"
      data-start-date="{{ event.data_start_date }}"
      data-end-date="{{ event.data_end_date }}">

    <article class="daily-event{% if event.page.new? %} new{% endif %}">
      <a href="{{ event.url }}" class="daily-event__link">
        <span class="daily-event__meta">
          {% if event.category %}
            <span class="event-cat data {{ event.category.basename }}">
              <span class="event-cat__icon" aria-hidden="true"></span>
              <span class="event-cat__text">{{ event.category.name }}</span>
            </span>
          {% endif %}

          {% assign has_datetime = false %}

          {% for specific in event.specifics %}
            {% if specific.datetime? %}
              {% assign has_datetime = true %}
              <span class="daily-event__time {{ specific.kind }}">
                <time datetime="{{ specific.start_at | ss_time: "iso" }}" class="start">
                  {{ specific.start_at | ss_time: "h_mm" }}
                </time>
                <span class="unit">-</span>
                <time datetime="{{ specific.end_at | ss_time: "iso" }}" class="end">
                  {{ specific.end_at | ss_time: "h_mm" }}
                </time>
              </span>
            {% endif %}
          {% endfor %}

          {% unless has_datetime %}
            <span class="daily-event__time daily-event__time--allday">終日</span>
          {% endunless %}
        </span>

        <span class="daily-event__name">{{ event.name }}</span>
      </a>
    </article>
  </div>
{% endfor %}
